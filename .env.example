# ============================================================
# ADAPTIVE INSPECTION INTELLIGENCE PLATFORM — Environment Config
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Database
POSTGRES_USER=aiip_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=aiip_db

# JWT Secrets — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_HEX_STRING
REFRESH_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_RANDOM_32_CHAR_STRING

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App Environment
ENVIRONMENT=development

# File Upload
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (used by Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
